require_text("${CONTRACT_TEXT}" "\"projectops.artifact-layout.v1\"")

string(FIND "${TOOLS_TEXT}" "$Global:DebugBundleRoot = Join-Path $Global:SubspaceRoot \"dist\\debug\"" OLD_DEBUG)
string(FIND "${TOOLS_TEXT}" "$Global:SourceBundleRoot = Join-Path $Global:SubspaceRoot \"dist\\source\"" OLD_SOURCE)
string(FIND "${TOOLS_TEXT}" "$Global:AssetBundleRoot = Join-Path $Global:SubspaceRoot \"dist\\assets\"" OLD_ASSETS)
string(FIND "${TOOLS_TEXT}" "$Global:LogsRoot = Join-Path $Global:SubspaceRoot \"logs\"" OLD_LOGS)
if(NOT OLD_DEBUG EQUAL -1 OR NOT OLD_SOURCE EQUAL -1 OR NOT OLD_ASSETS EQUAL -1 OR NOT OLD_LOGS EQUAL -1)
