cmake_minimum_required(VERSION 3.20)
get_filename_component(SUBSPACE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(BUILDER "${SUBSPACE_ROOT}/engine/src/ship_editor/ShipyardBuilderSystem.cpp")
set(AXIS_TEST "${SUBSPACE_ROOT}/engine/tests/studio_axis_contract_r34_tests.cpp")
if(NOT EXISTS "${BUILDER}")
  message(FATAL_ERROR "R82R2: missing ShipyardBuilderSystem.cpp")
endif()
file(READ "${BUILDER}" B)
string(FIND "${B}" "model_.recipe.modules.push_back(preview.ghost);" GHOST_COMMIT)
if(GHOST_COMMIT EQUAL -1)
  message(FATAL_ERROR "R82R2: snapped placement must commit the authoritative staged ghost")
endif()
string(FIND "${B}" "model_.recipe.modules.push_back(c.placement);" STALE_COMMIT)
if(NOT STALE_COMMIT EQUAL -1)
  message(FATAL_ERROR "R82R2: stale candidate-placement commit still present")
endif()
if(NOT EXISTS "${AXIS_TEST}")
  message(FATAL_ERROR "R82R2: missing R34 axis contract test")
endif()
file(READ "${AXIS_TEST}" A)
string(FIND "${A}" "assert(" RAW_ASSERT)
if(NOT RAW_ASSERT EQUAL -1)
  message(FATAL_ERROR "R82R2: R34 test still uses modal CRT assert() diagnostics")
endif()
string(FIND "${A}" "R34 axis-contract assertions:" DIAG_TOKEN)
if(DIAG_TOKEN EQUAL -1)
  message(FATAL_ERROR "R82R2: R34 diagnostic assertion summary missing")
endif()
message(STATUS "Subspace R82R2 snapped-commit + nonmodal axis diagnostics PASS")
