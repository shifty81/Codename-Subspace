cmake_minimum_required(VERSION 3.20)
# Pass1443: certify historical static gates resolve repository paths independent of CTest/script working directory.
get_filename_component(P1443_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(_gate "${P1443_ROOT}/tools/control/static-gates/pass1339r2_source_artifact_handoff_classification.cmake")
if(NOT EXISTS "${_gate}")
  message(FATAL_ERROR "PASS1443 missing repaired Pass1339R2 gate: ${_gate}")
endif()
file(READ "${_gate}" _text)
foreach(_token IN ITEMS "CMAKE_CURRENT_LIST_DIR" "../../.." "StandaloneProjectControlCenter.ps1" "SubspaceTools.ps1")
  string(FIND "${_text}" "${_token}" _idx)
  if(_idx EQUAL -1)
    message(FATAL_ERROR "PASS1443 repaired Pass1339R2 gate missing token: ${_token}")
  endif()
endforeach()
string(FIND "${_text}" "CMAKE_SOURCE_DIR" _bad)
if(NOT _bad EQUAL -1)
  message(FATAL_ERROR "PASS1443 repaired Pass1339R2 gate still depends on CMAKE_SOURCE_DIR")
endif()
message(STATUS "PASS1443 historical static-gate path authority repair PASS")
