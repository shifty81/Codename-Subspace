cmake_minimum_required(VERSION 3.20)
# PASS1508R5: a single UI stack, panel-specific foreground paint and one
# camera pixel-pan mapping for both game and main-menu Shipyard.
get_filename_component(PASS1508R5_PROJECT_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(PASS1508R5_RENDER "${PASS1508R5_PROJECT_ROOT}/engine/src/application/NativeBattlefieldRenderer.cpp")
set(PASS1508R5_HIT "${PASS1508R5_PROJECT_ROOT}/engine/src/ship_editor/ShipyardProfessionalVisibleCutover.cpp")
set(PASS1508R5_INPUT "${PASS1508R5_PROJECT_ROOT}/engine/include/ship_editor/ShipyardDockPointerSystem.h")
set(PASS1508R5_APP "${PASS1508R5_PROJECT_ROOT}/engine/src/application/NativeGameApplication.cpp")
set(PASS1508R5_CAMERA "${PASS1508R5_PROJECT_ROOT}/engine/src/editor/ConstructionEditorCameraSystem.cpp")
set(PASS1508R5_PROJECTION "${PASS1508R5_PROJECT_ROOT}/engine/src/rendering/StrategicViewProjection.cpp")
set(PASS1508R5_DOCK "${PASS1508R5_PROJECT_ROOT}/engine/src/ui/SubspaceUiFramework.cpp")
set(PASS1508R5_TEST "${PASS1508R5_PROJECT_ROOT}/engine/tests/pass1508r5_gui_camera_normalization_tests.cpp")
set(PASS1508R5_CMAKE "${PASS1508R5_PROJECT_ROOT}/engine/CMakeLists.txt")
foreach(PASS1508R5_NAME IN ITEMS RENDER HIT INPUT APP CAMERA PROJECTION DOCK TEST CMAKE)
  if(NOT EXISTS "${PASS1508R5_${PASS1508R5_NAME}}")
    message(FATAL_ERROR "PASS1508R5 source missing: ${PASS1508R5_NAME}")
  endif()
  file(READ "${PASS1508R5_${PASS1508R5_NAME}}" PASS1508R5_${PASS1508R5_NAME}_TEXT)
endforeach()
foreach(PASS1508R5_MARK IN ITEMS
    "const auto panelLayers=ShipyardPanelCompositorSystem::Snapshot"
    "ShipyardPanelClip clip(d.rect.x,d.rect.y,d.rect.width,d.rect.height"
    "opaquePanel.a=1.0f"
    "for(const auto& c:controls)if(c.panelId==d.panelId)drawControl(c)"
    "if(d.panelId==\"properties\")drawPropertyContext()")
  string(FIND "${PASS1508R5_RENDER_TEXT}" "${PASS1508R5_MARK}" PASS1508R5_POSITION)
  if(PASS1508R5_POSITION EQUAL -1)
    message(FATAL_ERROR "PASS1508R5 floating-panel compositor lost: ${PASS1508R5_MARK}")
  endif()
endforeach()
string(FIND "${PASS1508R5_RENDER_TEXT}" "// Dock UI is painted first; float UI is painted later in stack order." PASS1508R5_DOCK_PASS)
string(FIND "${PASS1508R5_RENDER_TEXT}" "// PASS1508R5 / compositor normalization:" PASS1508R5_FLOAT_PASS)
if(PASS1508R5_DOCK_PASS EQUAL -1 OR PASS1508R5_FLOAT_PASS LESS_EQUAL PASS1508R5_DOCK_PASS)
  message(FATAL_ERROR "PASS1508R5 draw order must be dock controls then complete floating windows")
endif()
foreach(PASS1508R5_MARK IN ITEMS
    "TopFloatingAt(layers,x,y)"
    "if(topFloating&&it->panelId!=topFloating->panelId)continue")
  string(FIND "${PASS1508R5_HIT_TEXT}" "${PASS1508R5_MARK}" PASS1508R5_POSITION)
  if(PASS1508R5_POSITION EQUAL -1)
    message(FATAL_ERROR "PASS1508R5 hit testing no longer follows paint stack: ${PASS1508R5_MARK}")
  endif()
endforeach()
foreach(PASS1508R5_MARK IN ITEMS
    "TopFloatingAt(layers,x,y)"
    "if(pass==1&&topFloating)return false"
    "RaiseFloatingPanel(w,panel_)")
  string(FIND "${PASS1508R5_INPUT_TEXT}" "${PASS1508R5_MARK}" PASS1508R5_POSITION)
  if(PASS1508R5_POSITION EQUAL -1)
    message(FATAL_ERROR "PASS1508R5 pointer stack drift: ${PASS1508R5_MARK}")
  endif()
endforeach()
string(REGEX MATCHALL "ConstructionEditorCameraSystem::PanPixels\\(_constructionCamera,panX,panY" PASS1508R5_PANS "${PASS1508R5_APP_TEXT}")
list(LENGTH PASS1508R5_PANS PASS1508R5_PAN_COUNT)
if(NOT PASS1508R5_PAN_COUNT EQUAL 2)
  message(FATAL_ERROR "PASS1508R5 standalone and in-game pan must share PanPixels: found ${PASS1508R5_PAN_COUNT}")
endif()
foreach(PASS1508R5_MARK IN ITEMS "TruckPedestal(s,-dx*scale,dy*scale)" "StrategicViewProjectionConfig{}.verticalFovDegrees")
  string(FIND "${PASS1508R5_CAMERA_TEXT}" "${PASS1508R5_MARK}" PASS1508R5_POSITION)
  if(PASS1508R5_POSITION EQUAL -1)
    message(FATAL_ERROR "PASS1508R5 camera projection/direction drift: ${PASS1508R5_MARK}")
  endif()
endforeach()
foreach(PASS1508R5_TEXT IN ITEMS "${PASS1508R5_CAMERA_TEXT}" "${PASS1508R5_PROJECTION_TEXT}")
  string(FIND "${PASS1508R5_TEXT}" "if(std::fabs(s.forward.z)>.985f)worldUp=" PASS1508R5_OLD_CAMERA)
  string(FIND "${PASS1508R5_TEXT}" "if(std::fabs(Dot(out.forward,worldUp))>0.985f)worldUp=" PASS1508R5_OLD_PROJECTION)
  if(NOT PASS1508R5_OLD_CAMERA EQUAL -1 OR NOT PASS1508R5_OLD_PROJECTION EQUAL -1)
    message(FATAL_ERROR "PASS1508R5 discontinuous pole basis was restored")
  endif()
endforeach()
foreach(PASS1508R5_MARK IN ITEMS "RaiseFloatingPanel" "std::rotate(it,it+1,w.floatingPanels.end())")
  string(FIND "${PASS1508R5_DOCK_TEXT}" "${PASS1508R5_MARK}" PASS1508R5_POSITION)
  if(PASS1508R5_POSITION EQUAL -1)
    message(FATAL_ERROR "PASS1508R5 frontmost floating window drift: ${PASS1508R5_MARK}")
  endif()
endforeach()
string(FIND "${PASS1508R5_CMAKE_TEXT}" "SubspacePass1508R5GuiCameraNormalizationTests" PASS1508R5_POSITION)
if(PASS1508R5_POSITION EQUAL -1)
  message(FATAL_ERROR "PASS1508R5 native regression not part of CTest")
endif()
message(STATUS "PASS1508R5 panel compositor + camera authority source guard PASS")
