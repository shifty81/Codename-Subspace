diff --git a/engine/tests/s15b_camera_orbit_smoke.cpp b/engine/tests/s15b_camera_orbit_smoke.cpp
new file mode 100644
--- /dev/null
+++ b/engine/tests/s15b_camera_orbit_smoke.cpp
@@ -0,0 +1,28 @@
+#include "editor/ConstructionEditorCameraSystem.h"
+#include "rendering/StrategicViewProjection.h"
+#include <cmath>
+#include <iostream>
+using namespace subspace;
+namespace { float Dot(Vector3 a,Vector3 b){return a.x*b.x+a.y*b.y+a.z*b.z;} }
+int main(){
+    ConstructionEditorCameraState s;
+    ConstructionEditorCameraSystem::Reset(s,{0,0,0},6);
+    ConstructionEditorCameraSystem::Orbit(s,0,90-s.pitchDegrees);
+    StrategicCamera camera;
+    camera.SetEditorView(s.eye,ConstructionEditorCameraSystem::Target(s),0,s.up);
+    auto before=StrategicViewProjection::Build(camera,1280,720);
+    ConstructionEditorCameraSystem::Orbit(s,0,2);
+    camera.SetEditorView(s.eye,ConstructionEditorCameraSystem::Target(s),0,s.up);
+    auto after=StrategicViewProjection::Build(camera,1280,720);
+    if(Dot(before.right,after.right)<.99f||Dot(before.up,after.up)<.99f)return 1;
+    if(!(s.pitchDegrees>90.0f))return 2;
+    const auto pivot=s.assemblyCenter;
+    ConstructionEditorCameraSystem::Orbit(s,0,268);
+    if((s.assemblyCenter-pivot).length()>.0001f)return 3;
+    ConstructionEditorCameraSystem::Dolly(s,2);
+    ConstructionEditorCameraSystem::Orbit(s,0,1);
+    if(!std::isfinite(s.eye.x)||!std::isfinite(s.up.z))return 4;
+    ConstructionEditorCameraSystem::FramePreservingOrientation(s,{10,0,0},2);
+    if(!std::isfinite(s.eye.y)||!std::isfinite(s.up.x))return 5;
+    std::cout<<"S15B editor orbital camera smoke PASS\n";
+}
