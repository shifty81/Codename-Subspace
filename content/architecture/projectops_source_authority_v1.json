{
  "schemaVersion": 1,
  "id": "projectops.source-authority.subspace.v1",
  "name": "Codename Subspace governed source authority",
  "description": "Filesystem-owned publication fingerprint and package/repository authority. All source packaging, baselines, GREEN certification and normalized GitHub staging consume this one contract.",
  "rootFiles": [
    ".editorconfig",
    ".gitattributes",
    ".gitignore",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CREDITS.md",
    "Dockerfile",
    "LICENSE",
    "Makefile",
    "MANIFEST.md",
    "README.md",
    "project.control.json",
    "SubspaceTools.cmd",
    "SubspaceTools.ps1",
    "InstallSubspaceTools.cmd"
  ],
  "includeRoots": [
    "engine",
    "scripts",
    "tools",
    "content",
    "GameData",
    "docs"
  ],
  "ignorePrefixes": [
    ".git/",
    ".vs/",
    ".subspace/",
    "artifacts/",
    "updates/",
    "build/",
    "out/",
    "dist/",
    "logs/",
    "assets/",
    "AvorionLike/",
    "engine/build/",
    "engine/build-headless/",
    "engine/build-headless-linux/",
    "engine/out/",
    "content/third_party/",
    "content/derived/",
    "content/imports/",
    "content/imported/",
    "content/downloads/",
    "content/generated/",
    "content/cache/",
    "tools/blender/dist/",
    "docs/archive/",
    "docs/build/",
    "docs/implementation/",
    "docs/migration/",
    "docs/normalization/",
    "docs/passes/",
    "docs/patch/",
    "docs/patches/",
    "docs/validation/",
    "docs/visual_acceptance/",
    "implementation/",
    "visual_acceptance/"
  ],
  "ignoreDirectoryNames": [
    "__pycache__",
    "node_modules",
    ".cache"
  ],
  "ignoreFileNames": [
    "Thumbs.db",
    ".DS_Store"
  ],
  "ignoreExtensions": [
    ".pyc",
    ".pyo",
    ".tmp",
    ".temp",
    ".log",
    ".zip",
    ".7z",
    ".rar",
    ".tar",
    ".gz",
    ".bz2",
    ".xz",
    ".exe",
    ".pdb",
    ".ilk",
    ".lib",
    ".dll",
    ".obj",
    ".fbx",
    ".glb",
    ".gltf",
    ".bin",
    ".png",
    ".jpg",
    ".jpeg",
    ".webp",
    ".gif",
    ".bmp",
    ".tga",
    ".dds",
    ".ktx",
    ".ktx2",
    ".hdr",
    ".exr",
    ".wav",
    ".ogg",
    ".mp3",
    ".flac",
    ".aac",
    ".mp4",
    ".webm",
    ".avi",
    ".mov",
    ".ttf",
    ".otf",
    ".woff",
    ".woff2",
    ".pdf",
    ".psd",
    ".kra",
    ".blend",
    ".blend1",
    ".onnx",
    ".gguf",
    ".rtf"
  ],
  "requiredBootstrapPaths": [
    "project.control.json",
    "SubspaceTools.cmd",
    "SubspaceTools.ps1",
    "engine/CMakeLists.txt",
    "tools/control/SubspaceControlCenter.ps1",
    "tools/control/ProjectCommandRegistry.ps1",
    "tools/control/ProjectOpsCli.py",
    "tools/control/ProjectShell.py",
    "tools/control/ProjectSourceAuthority.py",
    "tools/control/RepairGitWorkingCopy.py",
    "tools/control/UniversalTreeStage.psm1",
    "scripts/subspace_apply_update_inbox.ps1",
    "content/architecture/universal_tree_stage_v1.json",
    "content/architecture/universal_artifact_layout_v1.json",
    "content/architecture/projectops_source_authority_v1.json",
    "tools/control/ProjectOpsCommon.psm1",
    "tools/control/ProjectOpsRootAudit.ps1",
    "tools/control/ProjectOpsMaintenance.ps1",
    "tools/control/ProjectOpsNormalizationAudit.ps1"
  ],
  "normalization": {
    "singleAuthorityConsumers": [
      "full-quality-gate",
      "source-rollup",
      "packaging-baseline",
      "incremental-handoff",
      "normalized-repository-staging",
      "git-working-copy-repair"
    ],
    "legacyPassDocumentationExcluded": true,
    "pythonCachesForbidden": true,
    "historicalNamePatternsExcluded": true
  },
  "ignoreNamePatterns": [
    "PASS*.md",
    "PASS*.txt",
    "*_PASS*.md",
    "*_PASS*.txt",
    "CODENAME_SUBSPACE_HANDOFF_*.md",
    "ROADMAP_PROGRESS_*.md",
    "*_AUDIT_2026-*.md",
    "*_AUDIT_2026-*.csv",
    "*_AUDIT_SUMMARY.txt",
    "CPP_CONVERSION_*.md",
    "LEGACY_CSHARP_*.md"
  ],
  "ignoreExactPaths": [
    "docs/BUILD_CHECKPOINT_AFTER_PASS40.md"
  ]
}
