{
  "schema": "forge.project.v1",
  "schemaVersion": 1,
  "projectId": "codename-subspace",
  "displayName": "Codename Subspace \u2014 Rust Lane",
  "provider": {
    "id": "subspace.rust.internal_pcc.v1",
    "kind": "project-owned",
    "launcher": "PROJECT_CONTROL_CENTER.cmd",
    "script": "tools/project/SubspaceControl.ps1"
  },
  "operations": {
    "project.status": {
      "action": "status"
    },
    "build": {
      "action": "build"
    },
    "test": {
      "action": "test"
    },
    "run": {
      "action": "run"
    },
    "shipyard.run": {
      "action": "shipyard"
    },
    "server.run": {
      "action": "server"
    },
    "gate.full": {
      "action": "full-gate"
    },
    "diagnostics.bundle": {
      "action": "debug-bundle"
    },
    "git.commit_green": {
      "action": "git-commit-green"
    }
  },
  "patchContract": "forge.patch.v1",
  "forge": {
    "integration": "external",
    "vendored": false
  },
  "ember": {
    "integration": "external-host",
    "projectFile": "CodenameSubspace.emberproject"
  },
  "cortex": {
    "integration": "external-command-bridge",
    "directStateMutation": false
  },
  "parallelLane": {
    "root": "rust",
    "cppSibling": "../engine",
    "rule": "Rust lane is independently buildable/testable; root C++ PCC remains authoritative for C++ lane"
  }
}
